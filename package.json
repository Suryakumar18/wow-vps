{
  "name": "wowlifestyle-showcase",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:standalone": "cross-env BUILD_STANDALONE=1 next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "seed": "npm run seed:catalog && npm run seed:subcategories && npm run seed:content",
    "seed:catalog": "tsx prisma/seed.ts",
    "seed:subcategories": "tsx prisma/seed-subcategories.ts",
    "seed:content": "tsx prisma/seed-content.ts",
    "admin:create": "tsx prisma/create-admin.ts",
    "products:import": "tsx prisma/import-products.ts",
    "products:generate": "tsx prisma/generate-catalog.ts",
    "products:remove-generated": "tsx prisma/remove-generated-products.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.400.0",
    "next": "^15.0.0",
    "pg": "^8.22.0",
    "razorpay": "^2.9.8",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "server-only": "^0.0.1",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.5",
    "autoprefixer": "^10.4.19",
    "cross-env": "^10.1.0",
    "postcss": "^8.4.38",
    "prisma": "^7.9.1",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5"
  }
}
