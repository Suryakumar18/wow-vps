# Copy to `.env` and fill in. See DEPLOY.md §1 for what each one does.
# `.env` is gitignored; this file is not — never put real values here.

# ---------------------------------------------------------------------------
# Required — the app refuses to boot without these (app/server/env.ts)
# ---------------------------------------------------------------------------

# Pooled Postgres connection, used by the running app.
DATABASE_URL="postgresql://user:password@host:5432/postgres?pgbouncer=true"

# Unpooled connection, used by `prisma migrate`. Migrations against a
# transaction-mode pooler misbehave.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Signs EVERY session cookie — customer and admin alike. The name is
# historical. Must be at least 32 characters in production.
#   openssl rand -base64 48
# Changing it logs everyone out.
ADMIN_AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Strongly recommended
# ---------------------------------------------------------------------------

# The public origin. Drives canonical tags, OpenGraph URLs, sitemap.xml and
# robots.txt. Set this to the production domain, not a preview URL.
NEXT_PUBLIC_APP_URL="https://wowlifestyle.online"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Extra hosts Next/Image may load from, comma-separated. Bare hostnames are
# assumed HTTPS. Needed when product imagery moves off Unsplash and the VPS.
#   IMAGE_HOSTS="cdn.example.com,https://res.cloudinary.com,ik.imagekit.io"
IMAGE_HOSTS=""

# Seeds the first admin account (prisma/seed.ts). Only used when that email
# doesn't already exist — re-seeding never overwrites an existing password.
ADMIN_EMAIL="admin@wowlifestyle.com"
ADMIN_PASSWORD=""

# SFTP target for the admin Media Uploader. Without VPS_SSH_PASSWORD, uploads
# return 503 and nothing else is affected — the storefront's own images are
# plain URLs and don't touch this.
VPS_SSH_HOST="200.97.164.140"
VPS_SSH_USER="root"
VPS_SSH_PASSWORD=""

# Google Search Console verification meta tag.
GOOGLE_SITE_VERIFICATION=""

# Razorpay — required for checkout. Grab from
# https://dashboard.razorpay.com/app/keys (test keys start with rzp_test_).
# RAZORPAY_KEY_ID is used only server-side; NEXT_PUBLIC_RAZORPAY_KEY_ID is the
# same value re-exposed so the browser can open the checkout modal. The secret
# never leaves the server — it signs and verifies payment responses.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ---------------------------------------------------------------------------
# WhatsApp (Meta Cloud API) — registration OTP + order notifications.
# Full walkthrough: WHATSAPP_SETUP.md. Without these, order pings are skipped
# and the register flow prints its OTP to the server console in development.
# ---------------------------------------------------------------------------

# From the Meta app: WhatsApp → API Setup. The token must be a *permanent*
# system-user token — the dashboard's default one expires in 24 hours.
WHATSAPP_ACCESS_TOKEN=""
# The numeric "Phone number ID" shown under the sender number (not the number).
WHATSAPP_PHONE_NUMBER_ID=""

# Webhook handshake (WhatsApp → Configuration → Webhooks). Invent any random
# string, paste the same value in the dashboard's "Verify token" field.
# Callback URL: https://<your-domain>/api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=""
# App settings → Basic → App secret. When set, webhook POSTs must carry a
# valid X-Hub-Signature-256 — set it in production.
WHATSAPP_APP_SECRET=""

# Where new-order alerts go. Digits with country code, e.g. 919876543210.
ADMIN_WHATSAPP_NUMBER=""

# Approved template names (see WHATSAPP_SETUP.md for the exact bodies).
# Leave empty to send free-form text — fine for testing, but WhatsApp only
# delivers free-form messages inside a 24h window after the customer last
# wrote to you, so production needs approved templates.
WHATSAPP_OTP_TEMPLATE=""
WHATSAPP_ORDER_USER_TEMPLATE=""
WHATSAPP_ORDER_ADMIN_TEMPLATE=""
# Language the templates were created in.
WHATSAPP_TEMPLATE_LANG="en_US"
